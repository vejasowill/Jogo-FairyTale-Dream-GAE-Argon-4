rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================================
    // 0. GLOBAL SAFETY NET (Default-Deny Catch-All)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 1. HARDENED GLOBAL PRIMITIVES
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // =========================================================================
    // 2. ENTITY VALIDATION BLUEPRINTS (Strict Owner Isolation + Idempotent Set/Update)
    // =========================================================================
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'photoURL',
          'legacyLocalUid',
          'appearance',
          'settings',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'displayName',
          'photoURL',
          'legacyLocalUid',
          'appearance',
          'settings',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string &&
        data.uid.size() >= 1 &&
        data.uid.size() <= 128 &&
        data.uid == request.auth.uid &&
        data.uid == userId &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 64 &&
        data.photoURL is string &&
        data.photoURL.size() >= 0 &&
        data.photoURL.size() <= 512 &&
        data.legacyLocalUid is string &&
        data.legacyLocalUid.size() >= 1 &&
        data.legacyLocalUid.size() <= 128 &&
        data.appearance is map &&
        data.appearance.size() <= 40 &&
        data.settings is map &&
        data.settings.size() <= 60 &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.uid is string &&
        data.uid.size() >= 1 &&
        data.uid.size() <= 128 &&
        data.uid == request.auth.uid &&
        data.uid == userId &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 254 &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        data.updatedAt is timestamp;
    }

    function isValidCloudWorldSave(data, userId, worldId) {
      return data.keys().hasAll([
          'worldId',
          'ownerId',
          'name',
          'seed',
          'seedText',
          'difficulty',
          'dayCount',
          'timeOfDay',
          'playerLevel',
          'exploredChunksCount',
          'gameVersion',
          'worldGenVersion',
          'checksum',
          'clientUpdatedAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'worldId',
          'ownerId',
          'name',
          'seed',
          'seedText',
          'difficulty',
          'dayCount',
          'timeOfDay',
          'playerLevel',
          'exploredChunksCount',
          'gameVersion',
          'worldGenVersion',
          'checksum',
          'clientUpdatedAt',
          'storageVersion',
          'activeRevisionId',
          'previousRevisionId',
          'storageBackend',
          'totalBytes',
          'totalChunksCount',
          'chunkIndexSummary',
          'savePayload',
          'createdAt',
          'updatedAt'
        ]) &&
        data.worldId is string &&
        data.worldId.size() >= 1 &&
        data.worldId.size() <= 128 &&
        data.worldId == worldId &&
        data.ownerId is string &&
        data.ownerId.size() >= 1 &&
        data.ownerId.size() <= 128 &&
        data.ownerId == request.auth.uid &&
        data.ownerId == userId &&
        data.name is string &&
        data.name.size() >= 1 &&
        data.name.size() <= 64 &&
        (data.seed is int || data.seed is float) &&
        data.seed >= 0 &&
        data.seed <= 2147483647 &&
        data.seedText is string &&
        data.seedText.size() >= 1 &&
        data.seedText.size() <= 64 &&
        data.difficulty is string &&
        data.difficulty in ['normal', 'survival', 'hardcore'] &&
        (data.dayCount is int || data.dayCount is float) &&
        data.dayCount >= 1 &&
        data.dayCount <= 1000000 &&
        (data.timeOfDay is int || data.timeOfDay is float) &&
        data.timeOfDay >= 0 &&
        data.timeOfDay <= 24 &&
        (data.playerLevel is int || data.playerLevel is float) &&
        data.playerLevel >= 1 &&
        data.playerLevel <= 9999 &&
        (data.exploredChunksCount is int || data.exploredChunksCount is float) &&
        data.exploredChunksCount >= 0 &&
        data.exploredChunksCount <= 1000000 &&
        data.gameVersion is string &&
        data.gameVersion.size() >= 1 &&
        data.gameVersion.size() <= 32 &&
        (data.worldGenVersion is int || data.worldGenVersion is float) &&
        data.worldGenVersion >= 1 &&
        data.worldGenVersion <= 1000 &&
        data.checksum is string &&
        data.checksum.size() >= 1 &&
        data.checksum.size() <= 128 &&
        (data.clientUpdatedAt is int || data.clientUpdatedAt is float) &&
        data.clientUpdatedAt >= 0 &&
        (!('storageVersion' in data) || ((data.storageVersion is int || data.storageVersion is float) && data.storageVersion >= 1 && data.storageVersion <= 10)) &&
        (!('activeRevisionId' in data) || (data.activeRevisionId is string && data.activeRevisionId.size() <= 128)) &&
        (!('previousRevisionId' in data) || (data.previousRevisionId is string && data.previousRevisionId.size() <= 128)) &&
        (!('storageBackend' in data) || (data.storageBackend is string && data.storageBackend in ['firebase_storage', 'hybrid_segmented', 'server_storage'])) &&
        (!('totalBytes' in data) || ((data.totalBytes is int || data.totalBytes is float) && data.totalBytes >= 0)) &&
        (!('totalChunksCount' in data) || ((data.totalChunksCount is int || data.totalChunksCount is float) && data.totalChunksCount >= 0)) &&
        (!('chunkIndexSummary' in data) || (data.chunkIndexSummary is map && data.chunkIndexSummary.size() <= 60)) &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        data.updatedAt is timestamp;
    }

    function isValidCloudWorldChunk(data, userId, worldId, chunkKey) {
      return data.keys().hasAll([
          'chunkKey',
          'worldId',
          'ownerId',
          'layer',
          'partIndex',
          'totalParts',
          'hash',
          'sizeBytes',
          'storagePath',
          'revisionId',
          'chunkData',
          'clientUpdatedAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'chunkKey',
          'worldId',
          'ownerId',
          'layer',
          'partIndex',
          'totalParts',
          'hash',
          'sizeBytes',
          'storagePath',
          'revisionId',
          'chunkData',
          'clientUpdatedAt',
          'createdAt',
          'updatedAt'
        ]) &&
        data.chunkKey is string &&
        data.chunkKey.size() >= 1 &&
        data.chunkKey.size() <= 128 &&
        data.chunkKey == chunkKey &&
        data.worldId is string &&
        data.worldId.size() >= 1 &&
        data.worldId.size() <= 128 &&
        data.worldId == worldId &&
        data.ownerId is string &&
        data.ownerId.size() >= 1 &&
        data.ownerId.size() <= 128 &&
        data.ownerId == request.auth.uid &&
        data.ownerId == userId &&
        data.layer is string &&
        data.layer in ['surface', 'underground', 'entities', 'manifest', 'snapshot'] &&
        (data.partIndex is int || data.partIndex is float) &&
        data.partIndex >= 0 &&
        data.partIndex <= 100000 &&
        (data.totalParts is int || data.totalParts is float) &&
        data.totalParts >= 1 &&
        data.totalParts <= 100000 &&
        data.hash is string &&
        data.hash.size() >= 1 &&
        data.hash.size() <= 128 &&
        (data.sizeBytes is int || data.sizeBytes is float) &&
        data.sizeBytes >= 0 &&
        data.sizeBytes <= 10485760 &&
        data.storagePath is string &&
        data.storagePath.size() >= 1 &&
        data.storagePath.size() <= 512 &&
        data.revisionId is string &&
        data.revisionId.size() >= 1 &&
        data.revisionId.size() <= 128 &&
        data.chunkData is map &&
        data.chunkData.size() <= 60 &&
        (data.clientUpdatedAt is int || data.clientUpdatedAt is float) &&
        data.clientUpdatedAt >= 0 &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        data.updatedAt is timestamp;
    }

    function isValidCloudGuestProfile(data, userId, worldId) {
      return data.keys().hasAll([
          'worldId',
          'ownerId',
          'playerLevel',
          'clientUpdatedAt',
          'playerPayload',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'worldId',
          'ownerId',
          'playerLevel',
          'clientUpdatedAt',
          'playerPayload',
          'createdAt',
          'updatedAt'
        ]) &&
        data.worldId is string &&
        data.worldId.size() >= 1 &&
        data.worldId.size() <= 128 &&
        data.worldId == worldId &&
        data.ownerId is string &&
        data.ownerId.size() >= 1 &&
        data.ownerId.size() <= 128 &&
        data.ownerId == request.auth.uid &&
        data.ownerId == userId &&
        (data.playerLevel is int || data.playerLevel is float) &&
        data.playerLevel >= 1 &&
        data.playerLevel <= 9999 &&
        (data.clientUpdatedAt is int || data.clientUpdatedAt is float) &&
        data.clientUpdatedAt >= 0 &&
        data.playerPayload is map &&
        data.playerPayload.size() <= 80 &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        data.updatedAt is timestamp;
    }

    // =========================================================================
    // 3. COLLECTION RULES
    // =========================================================================

    // 3.1 Root User Profile (/users/{userId})
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId);

      allow update: if isVerifiedUser() &&
        isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid;

      allow delete: if false;

      // 3.2 Isolated PII Subcollection (/users/{userId}/private/{docId})
      match /private/{docId} {
        allow get: if isSignedIn() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(docId) &&
          (resource == null || existing().uid == request.auth.uid);

        allow list: if false;

        allow create: if isVerifiedUser() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(docId) &&
          docId == 'account' &&
          isValidUserPrivateInfo(incoming(), userId);

        allow update: if isVerifiedUser() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(docId) &&
          docId == 'account' &&
          isValidUserPrivateInfo(incoming(), userId) &&
          incoming().uid == existing().uid;

        allow delete: if false;
      }

      // 3.3 Cloud Saved Worlds Metadata & Manifest Index (/users/{userId}/worlds/{worldId})
      match /worlds/{worldId} {
        allow get: if isSignedIn() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(worldId) &&
          (resource == null || existing().ownerId == request.auth.uid);

        allow list: if isSignedIn() &&
          isOwner(userId) &&
          existing().ownerId == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(worldId) &&
          isValidCloudWorldSave(incoming(), userId, worldId);

        allow update: if isVerifiedUser() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(worldId) &&
          isValidCloudWorldSave(incoming(), userId, worldId) &&
          incoming().worldId == existing().worldId &&
          incoming().ownerId == existing().ownerId;

        allow delete: if isVerifiedUser() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(worldId) &&
          (resource == null || existing().ownerId == request.auth.uid);

        // 3.3.1 Independent Chunks & Multipart Segments (/users/{userId}/worlds/{worldId}/chunks/{chunkKey})
        match /chunks/{chunkKey} {
          allow get: if isSignedIn() &&
            isOwner(userId) &&
            isValidId(userId) &&
            isValidId(worldId) &&
            isValidId(chunkKey) &&
            (resource == null || existing().ownerId == request.auth.uid);

          allow list: if isSignedIn() &&
            isOwner(userId) &&
            existing().ownerId == request.auth.uid;

          allow create: if isVerifiedUser() &&
            isOwner(userId) &&
            isValidId(userId) &&
            isValidId(worldId) &&
            isValidId(chunkKey) &&
            isValidCloudWorldChunk(incoming(), userId, worldId, chunkKey);

          allow update: if isVerifiedUser() &&
            isOwner(userId) &&
            isValidId(userId) &&
            isValidId(worldId) &&
            isValidId(chunkKey) &&
            isValidCloudWorldChunk(incoming(), userId, worldId, chunkKey) &&
            incoming().chunkKey == existing().chunkKey &&
            incoming().worldId == existing().worldId &&
            incoming().ownerId == existing().ownerId;

          allow delete: if isVerifiedUser() &&
            isOwner(userId) &&
            isValidId(userId) &&
            isValidId(worldId) &&
            isValidId(chunkKey) &&
            (resource == null || existing().ownerId == request.auth.uid);
        }
      }

      // 3.4 Cloud Multiplayer Guest Profiles (/users/{userId}/guestProfiles/{worldId})
      match /guestProfiles/{worldId} {
        allow get: if isSignedIn() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(worldId) &&
          (resource == null || existing().ownerId == request.auth.uid);

        allow list: if isSignedIn() &&
          isOwner(userId) &&
          existing().ownerId == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(worldId) &&
          isValidCloudGuestProfile(incoming(), userId, worldId);

        allow update: if isVerifiedUser() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(worldId) &&
          isValidCloudGuestProfile(incoming(), userId, worldId) &&
          incoming().worldId == existing().worldId &&
          incoming().ownerId == existing().ownerId;

        allow delete: if isVerifiedUser() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(worldId) &&
          (resource == null || existing().ownerId == request.auth.uid);
      }

      // 3.5 Server-Authoritative Entitlements & Microtransactions (/users/{userId}/entitlements/{entitlementId})
      match /entitlements/{entitlementId} {
        allow get: if isSignedIn() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(entitlementId) &&
          (resource == null || existing().ownerId == request.auth.uid);

        allow list: if isSignedIn() &&
          isOwner(userId) &&
          existing().ownerId == request.auth.uid;

        // Strictly read-only from client SDK. Granted/revoked exclusively via backend Firebase Admin SDK.
        allow create, update, delete: if false;
      }
    }

    // 3.6 Connection Health Probe (/_connection_health/{probeId})
    match /_connection_health/{probeId} {
      allow get: if isValidId(probeId);
      allow list, create, update, delete: if false;
    }
  }
}
